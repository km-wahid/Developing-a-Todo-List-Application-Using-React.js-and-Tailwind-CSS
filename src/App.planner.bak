import { lazy, Suspense, useEffect, useRef, useState, type ReactNode } from 'react'
import type FullCalendar from '@fullcalendar/react'
import { DateTime } from 'luxon'
import {
  ArrowDown,
  ArrowRight,
  BookOpen,
  CalendarDays,
  Check,
  ChevronLeft,
  ChevronRight,
  Clock3,
  Compass,
  Flag,
  Globe2,
  HelpCircle,
  LayoutGrid,
  Loader2,
  LogOut,
  Menu,
  MoreHorizontal,
  Plus,
  Save,
  Settings2,
  ShieldCheck,
  Sparkles,
  Sprout,
  Trash2,
  UserRound,
  X,
} from 'lucide-react'
import { api, setCsrf, ApiError } from './api'
import {
  defaultPreferences,
  generatePlan,
  topics,
  validateActivities,
  preferencesSchema,
  activitySchema,
  type Activity,
  type Draft,
  type Plan,
  type PlanSummary,
  type PlanPage,
  type Preferences,
} from './shared/planner'

const PlannerCalendar = lazy(() => import('./Calendar'))

type User = { id: string; name: string; email: string; timezone: string }
type AuthMode = 'login' | 'register' | 'forgot' | 'resend' | 'verify' | 'reset'
const topicColors: Record<string, string> = {
  History: '#956042',
  Economics: '#4269bd',
  Business: '#587758',
  'Luxury & culture': '#9563a8',
  Travel: '#418579',
  Psychology: '#ae6882',
  Communication: '#bd7d38',
  'Personal development': '#7363b5',
}
const dayNames = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
const messageOf = (error: unknown) =>
  error instanceof Error ? error.message : 'Something went wrong. Please try again.'
function Dialog({
  title,
  children,
  onClose,
  wide = false,
}: {
  title: string
  children: ReactNode
  onClose: () => void
  wide?: boolean
}) {
  const ref = useRef<HTMLDialogElement>(null)
  useEffect(() => {
    ref.current?.showModal()
    return () => ref.current?.close()
  }, [])
  return (
    <dialog
      ref={ref}
      className={`modal ${wide ? 'wide' : ''}`}
      onCancel={onClose}
      onClick={(e) => {
        if (e.target === ref.current) onClose()
      }}
      aria-label={title}
    >
      <div className="modal-header">
        <h2>{title}</h2>
        <button className="icon-button" onClick={onClose} aria-label="Close dialog">
          <X size={19} />
        </button>
      </div>
      {children}
    </dialog>
  )
}
function AuthDialog({
  initial,
  token,
  onClose,
  onLogin,
}: {
  initial: AuthMode
  token?: string
  onClose: () => void
  onLogin: (user: User) => void
}) {
  const [mode, setMode] = useState(initial)
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState('')
  const [notice, setNotice] = useState('')
  const [link, setLink] = useState('')
  const labels = {
    login: 'Welcome back.',
    register: 'Make room for growth.',
    forgot: 'Reset your password.',
    resend: 'Verify your email.',
    verify: 'One last step.',
    reset: 'A fresh start.',
  }
  function switchMode(next: AuthMode) {
    setMode(next)
    setError('')
    setNotice('')
    setLink('')
  }
  async function submit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()
    setBusy(true)
    setError('')
    setNotice('')
    setLink('')
    const data = Object.fromEntries(new FormData(event.currentTarget))
    try {
      if (mode === 'login') {
        const response = await api<{ user: User; csrf: string }>('/auth/login', data)
        setCsrf(response.csrf)
        onLogin(response.user)
        onClose()
      } else {
        const endpoints = {
          register: 'register',
          forgot: 'forgot-password',
          resend: 'request-verification',
          verify: 'verify',
          reset: 'reset-password',
        }
        const response = await api<{ message: string; developmentLink?: string }>(
          `/auth/${endpoints[mode]}`,
          {
            ...data,
            ...(mode === 'register'
              ? { timezone: Intl.DateTimeFormat().resolvedOptions().timeZone }
              : {}),
            ...(token ? { token } : {}),
          },
        )
        setNotice(response.message)
        setLink(response.developmentLink ?? '')
        if (mode === 'verify' || mode === 'reset') {
          history.replaceState(null, '', '/')
          setMode('login')
        }
      }
    } catch (e) {
      setError(messageOf(e))
    } finally {
      setBusy(false)
    }
  }
  return (
    <Dialog title={labels[mode]} onClose={onClose}>
      <p className="modal-intro">
        {mode === 'login'
          ? 'Your week, your interests, your own pace.'
          : mode === 'register'
            ? 'A little intention today. A more interesting tomorrow.'
            : 'We’ll help you get back to your personal space.'}
      </p>
      <form onSubmit={submit} className="auth-form">
        <fieldset disabled={busy}>
          {mode === 'register' && (
            <label>
              Your name
              <input
                name="name"
                required
                maxLength={80}
                autoComplete="name"
                placeholder="Alex Morgan"
              />
            </label>
          )}
          {!['verify', 'reset'].includes(mode) && (
            <label>
              Email address
              <input
                name="email"
                type="email"
                required
                maxLength={254}
                autoComplete="email"
                placeholder="you@example.com"
              />
            </label>
          )}
          {['login', 'register', 'reset'].includes(mode) && (
            <label>
              {mode === 'reset' ? 'New password' : 'Password'}
              <input
                name="password"
                type="password"
                required
                minLength={mode === 'login' ? 1 : 12}
                maxLength={128}
                autoComplete={mode === 'login' ? 'current-password' : 'new-password'}
                placeholder={mode === 'login' ? 'Your password' : 'At least 12 characters'}
              />
            </label>
          )}
          {error && (
            <p role="alert" className="inline-error">
              {error}
            </p>
          )}
          {notice && (
            <p role="status" className="inline-success">
              {notice}
            </p>
          )}
          {link && (
            <p className="dev-note">
              Email delivery isn’t configured locally.{' '}
              <a href={link}>
                Open the development link <ArrowRight size={13} />
              </a>
            </p>
          )}
          <button className="button primary full" type="submit">
            {busy ? <Loader2 size={17} className="spin" /> : <ArrowRight size={17} />}{' '}
            {mode === 'login'
              ? 'Sign in'
              : mode === 'register'
                ? 'Create account'
                : mode === 'verify'
                  ? 'Verify my email'
                  : mode === 'reset'
                    ? 'Update password'
                    : 'Send email'}
          </button>
        </fieldset>
      </form>
      <div className="auth-links">
        {mode === 'login' ? (
          <>
            <button onClick={() => switchMode('forgot')}>Forgot password?</button>
            <button onClick={() => switchMode('resend')}>Resend verification</button>
            <p>
              New here? <button onClick={() => switchMode('register')}>Create an account</button>
            </p>
          </>
        ) : (
          <button onClick={() => switchMode('login')}>Back to sign in</button>
        )}
      </div>
      <div className="privacy-note">
        <ShieldCheck size={15} /> Your plans are private. Always.
      </div>
    </Dialog>
  )
}
function ActivityDialog({
  activity,
  preferences,
  activities,
  onClose,
  onApply,
  onDelete,
}: {
  activity: Activity
  preferences: Preferences
  activities: Activity[]
  onClose: () => void
  onApply: (a: Activity) => void
  onDelete: () => void
}) {
  const [error, setError] = useState('')
  function submit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()
    const values = Object.fromEntries(new FormData(event.currentTarget))
    const parsed = activitySchema.safeParse({
      ...activity,
      title: values.title,
      instructions: values.instructions,
      start: `${values.date}T${values.time}`,
      duration: Number(values.duration),
    })
    if (!parsed.success) {
      setError(parsed.error.issues.map((i) => i.message).join(' '))
      return
    }
    const issues = validateActivities(
      preferences,
      activities.map((a) => (a.id === activity.id ? parsed.data : a)),
    )
    if (issues.length) {
      setError(issues.join(' '))
      return
    }
    onApply(parsed.data)
    onClose()
  }
  return (
    <Dialog title="A little time for you" onClose={onClose}>
      <span className="topic-label" style={{ color: topicColors[activity.topic] }}>
        <span className="dot" />
        {activity.topic}
      </span>
      <form onSubmit={submit} className="activity-form">
        <label>
          Activity
          <input name="title" defaultValue={activity.title} required maxLength={160} />
        </label>
        <label>
          Your starting point
          <textarea
            name="instructions"
            defaultValue={activity.instructions}
            rows={4}
            maxLength={2000}
          />
        </label>
        <div className="form-grid">
          <label>
            Date
            <input
              name="date"
              type="date"
              defaultValue={activity.start.slice(0, 10)}
              min={preferences.weekStart}
              max={DateTime.fromISO(preferences.weekStart).plus({ days: 6 }).toISODate()!}
              required
            />
          </label>
          <label>
            Start time
            <input name="time" type="time" defaultValue={activity.start.slice(11)} required />
          </label>
        </div>
        <label>
          Duration (minutes)
          <input
            name="duration"
            type="number"
            min={15}
            max={240}
            step={15}
            defaultValue={activity.duration}
            required
          />
        </label>
        <p className="hint">Times are in {preferences.timezone.replaceAll('_', ' ')}.</p>
        {error && (
          <p role="alert" className="inline-error">
            {error}
          </p>
        )}
        <div className="modal-actions">
          <button
            type="button"
            className="button danger"
            onClick={() => {
              if (confirm('Remove this activity from your draft?')) {
                onDelete()
                onClose()
              }
            }}
          >
            <Trash2 size={16} />
            Remove
          </button>
          <button className="button primary" type="submit">
            <Check size={17} />
            Apply changes
          </button>
        </div>
      </form>
    </Dialog>
  )
}
export default function App() {
  const [user, setUser] = useState<User | null>(null)
  const [sessionLoading, setSessionLoading] = useState(true)
  const [preferences, setPreferences] = useState<Preferences>(defaultPreferences)
  const [draft, setDraft] = useState<Draft>(() => generatePlan(defaultPreferences()))
  const [saved, setSaved] = useState<Plan | null>(null)
  const [dirty, setDirty] = useState(false)
  const [busy, setBusy] = useState(false)
  const [error, setError] = useState('')
  const [notice, setNotice] = useState('')
  const [auth, setAuth] = useState<AuthMode | null>(() =>
    new URLSearchParams(location.search).has('verify')
      ? 'verify'
      : new URLSearchParams(location.search).has('reset')
        ? 'reset'
        : null,
  )
  const [selected, setSelected] = useState<Activity | null>(null)
  const [view, setView] = useState<'planner' | 'weeks'>('planner')
  const [weeks, setWeeks] = useState<PlanSummary[]>([])
  const [nextCursor, setNextCursor] = useState<string | null>(null)
  const [mobileMenu, setMobileMenu] = useState(false)
  const [compact, setCompact] = useState(() => matchMedia('(max-width: 767px)').matches)
  const [calendarMode, setCalendarMode] = useState<'week' | 'agenda'>('week')
  const calendarRef = useRef<FullCalendar>(null)
  function handleError(error: unknown) {
    setError(messageOf(error))
    if (error instanceof ApiError && error.status === 401) setAuth('login')
  }
  const token =
    new URLSearchParams(location.search).get('verify') ??
    new URLSearchParams(location.search).get('reset') ??
    undefined
  useEffect(() => {
    const controller = new AbortController()
    api<{ user: User | null; csrf: string | null }>(
      '/auth/session',
      undefined,
      'GET',
      controller.signal,
    )
      .then((data) => {
        setUser(data.user)
        setCsrf(data.csrf)
        if (data.user) setPreferences((p) => ({ ...p, timezone: data.user!.timezone }))
      })
      .catch((e) => {
        if (e.name !== 'AbortError') handleError(e)
      })
      .finally(() => {
        if (!controller.signal.aborted) setSessionLoading(false)
      })
    const media = matchMedia('(max-width: 767px)')
    const listener = () => setCompact(media.matches)
    media.addEventListener('change', listener)
    return () => {
      controller.abort()
      media.removeEventListener('change', listener)
    }
  }, [])
  useEffect(() => {
    calendarRef.current
      ?.getApi()
      .changeView(compact || calendarMode === 'agenda' ? 'listWeek' : 'timeGridWeek')
  }, [compact, calendarMode])
  useEffect(() => {
    if (!user) return
    const controller = new AbortController()
    setBusy(true)
    setError('')
    api<Plan[]>(`/plans?week=${preferences.weekStart}`, undefined, 'GET', controller.signal)
      .then((data) => {
        setSaved(data[0] ?? null)
        setDirty(false)
        if (data[0]) {
          setDraft(data[0])
          setPreferences(data[0].preferences)
        } else setDraft({ preferences, activities: [], messages: [] })
      })
      .catch((e) => {
        if (e.name !== 'AbortError') handleError(e)
      })
      .finally(() => {
        if (!controller.signal.aborted) setBusy(false)
      })
    return () => controller.abort()
    // Loading is tied to the account and week, not changes to unsaved preferences.
  }, [user?.id, preferences.weekStart])
  useEffect(() => {
    const handler = (event: BeforeUnloadEvent) => {
      if (dirty) event.preventDefault()
    }
    window.addEventListener('beforeunload', handler)
    return () => window.removeEventListener('beforeunload', handler)
  }, [dirty])
  const totalMinutes = draft.activities.reduce((n, a) => n + a.duration, 0)
  const learningCount = draft.activities.filter((a) => a.kind === 'learn').length
  const weekDate = DateTime.fromISO(preferences.weekStart)
  const endDate = weekDate.plus({ days: 6 })
  const weekLabel = `${weekDate.toFormat('MMM d')} – ${endDate.toFormat(weekDate.month === endDate.month ? 'd, yyyy' : 'MMM d, yyyy')}`
  const unavailable = draft.activities.some(
    (a) => !draft.preferences.weekdays.includes(DateTime.fromISO(a.start).weekday),
  )
  function updatePreference<K extends keyof Preferences>(key: K, value: Preferences[K]) {
    setPreferences((p) => ({ ...p, [key]: value }))
  }
  async function generate() {
    if (dirty && !confirm('Generate a new draft? Your unsaved activity edits will be replaced.'))
      return
    const parsed = preferencesSchema.safeParse(preferences)
    if (!parsed.success) {
      setError(parsed.error.issues.map((i) => i.message).join(' '))
      return
    }
    setBusy(true)
    setError('')
    setNotice('')
    try {
      setDraft(user ? await api<Draft>('/plans/generate', preferences) : generatePlan(preferences))
      setDirty(true)
    } catch (e) {
      handleError(e)
    } finally {
      setBusy(false)
    }
  }
  async function save() {
    if (!user) {
      setAuth('register')
      return
    }
    setBusy(true)
    setError('')
    setNotice('')
    try {
      const plan = await api<Plan>(
        '/plans',
        {
          preferences: draft.preferences,
          activities: draft.activities,
          revision: saved?.revision ?? 0,
        },
        'PUT',
      )
      setSaved(plan)
      setDraft(plan)
      setDirty(false)
      setNotice('Your week is saved. A little intention goes a long way.')
    } catch (e) {
      handleError(e)
    } finally {
      setBusy(false)
    }
  }
  async function reload() {
    if (dirty && !confirm('Reload the saved week? Unsaved edits will be discarded.')) return
    setBusy(true)
    setError('')
    try {
      const plans = await api<Plan[]>(`/plans?week=${preferences.weekStart}`)
      setSaved(plans[0] ?? null)
      setDraft(plans[0] ?? { preferences, activities: [], messages: [] })
      if (plans[0]) setPreferences(plans[0].preferences)
      setDirty(false)
    } catch (e) {
      handleError(e)
    } finally {
      setBusy(false)
    }
  }
  function navigateWeek(week: string) {
    if (week === preferences.weekStart) return
    if (dirty && !confirm('Leave this week? Unsaved changes will be discarded.')) return
    setDirty(false)
    setSaved(null)
    setNotice('')
    setError('')
    setSelected(null)
    setPreferences((p) => ({ ...p, weekStart: week }))
    if (!user)
      setDraft({ preferences: { ...preferences, weekStart: week }, activities: [], messages: [] })
  }
  function apply(activity: Activity) {
    setDraft((d) => ({
      ...d,
      activities: d.activities.map((a) => (a.id === activity.id ? activity : a)),
    }))
    setDirty(true)
    setNotice('')
  }
  async function showWeeks(before?: string) {
    setMobileMenu(false)
    if (!user) {
      setAuth('login')
      return
    }
    setBusy(true)
    setError('')
    try {
      const page = await api<PlanPage>(`/plans${before ? `?before=${before}` : ''}`)
      setWeeks((current) => (before ? [...current, ...page.items] : page.items))
      setNextCursor(page.nextCursor)
      setView('weeks')
    } catch (e) {
      handleError(e)
    } finally {
      setBusy(false)
    }
  }
  async function signOut() {
    if (dirty && !confirm('Sign out? Unsaved changes will be discarded.')) return
    setBusy(true)
    try {
      await api('/auth/logout', {})
      setCsrf(null)
      setUser(null)
      setSaved(null)
      setDirty(false)
      setView('planner')
      setPreferences(defaultPreferences())
      setDraft(generatePlan(defaultPreferences()))
      setNotice('Signed out. You’re viewing a sample week.')
      setWeeks([])
    } catch (e) {
      handleError(e)
    } finally {
      setBusy(false)
    }
  }
  const eventHours = draft.activities.map((a) => Number(a.start.slice(11, 13)))
  const firstHour = Math.max(
    0,
    Math.min(...(eventHours.length ? eventHours : [Number(preferences.startTime.slice(0, 2))])) - 1,
  )
  const lastHour = Math.min(
    24,
    Math.max(
      firstHour + 4,
      ...draft.activities.map(
        (a) =>
          Math.ceil(
            Number(a.start.slice(11, 13)) + Number(a.start.slice(14)) / 60 + a.duration / 60,
          ) + 1,
      ),
    ),
  )
  const calendarEvents = draft.activities.map((a) => ({
    id: a.id,
    title: a.title,
    start: a.start,
    end: DateTime.fromISO(a.start, { zone: draft.preferences.timezone })
      .plus({ minutes: a.duration })
      .toFormat("yyyy-MM-dd'T'HH:mm"),
    backgroundColor: `${topicColors[a.topic]}14`,
    borderColor: topicColors[a.topic],
    textColor: topicColors[a.topic],
    extendedProps: { activity: a },
  }))
  return (
    <div className="app-shell">
      <aside className={`sidebar ${mobileMenu ? 'mobile-open' : ''}`}>
        <a
          href="/"
          className="brand"
          onClick={(e) => {
            e.preventDefault()
            setView('planner')
            setMobileMenu(false)
          }}
        >
          <span className="brand-mark">
            <Sprout size={22} />
          </span>
          bloom<span className="brand-period">.</span>
        </a>
        <span className="workspace-label">YOUR PERSONAL SPACE</span>
        <nav aria-label="Main navigation">
          <button
            className={`nav-item ${view === 'planner' ? 'active' : ''}`}
            onClick={() => {
              setView('planner')
              setMobileMenu(false)
            }}
          >
            <LayoutGrid size={19} /> My planner <span className="nav-dot" />
          </button>
          <button
            className={`nav-item ${view === 'weeks' ? 'active' : ''}`}
            disabled={busy}
            onClick={() => void showWeeks()}
          >
            <CalendarDays size={19} /> Saved weeks
          </button>
        </nav>
        <div className="sidebar-note">
          <span className="note-icon">
            <Sprout size={21} />
          </span>
          <h3>
            Small steps.
            <br />
            Bigger horizons.
          </h3>
          <p>
            You don’t have to do it all.
            <br />
            Just make a little room.
          </p>
          <span className="note-line" />
        </div>
        <div className="sidebar-bottom">
          <span className="private-label">
            <ShieldCheck size={15} /> A space that’s just yours
          </span>
          {user ? (
            <button className="profile" onClick={signOut} disabled={busy}>
              <span className="avatar">{user.name.charAt(0).toUpperCase()}</span>
              <span>
                <strong>{user.name}</strong>
                <small>Personal account</small>
              </span>
              <LogOut size={16} />
            </button>
          ) : (
            <button className="profile" onClick={() => setAuth('login')}>
              <span className="avatar">
                <UserRound size={18} />
              </span>
              <span>
                <strong>Your personal journey</strong>
                <small>Sign in to save your weeks</small>
              </span>
              <ArrowRight size={16} />
            </button>
          )}
        </div>
      </aside>
      {mobileMenu && (
        <button
          className="nav-scrim"
          aria-label="Close navigation"
          onClick={() => setMobileMenu(false)}
        />
      )}
      <div className="main-shell">
        <header className="topbar">
          <div className="breadcrumb">
            <button
              className="icon-button mobile-menu-button"
              onClick={() => setMobileMenu((v) => !v)}
              aria-label="Open navigation"
            >
              <Menu size={21} />
            </button>
            <span className="mobile-brand">
              <Sprout size={19} /> bloom.
            </span>
            <span className="desktop-breadcrumb">
              Personal workspace <ChevronRight size={14} />{' '}
              <strong>{view === 'planner' ? 'My planner' : 'Saved weeks'}</strong>
            </span>
          </div>
          <div className="topbar-actions">
            <span className="today">{DateTime.local().toFormat('ccc, MMM d')}</span>
            {!user && (
              <button
                className="button compact"
                disabled={sessionLoading}
                onClick={() => setAuth('login')}
              >
                Sign in <ArrowRight size={14} />
              </button>
            )}
            {user && (
              <span className="top-avatar" title={user.name}>
                {user.name.charAt(0).toUpperCase()}
              </span>
            )}
          </div>
        </header>
        <main>
          <section className="page-heading">
            <div>
              <div className="eyebrow">
                <span className="tiny-spark">
                  <Sparkles size={13} />
                </span>{' '}
                A LITTLE INTENTION, EVERY WEEK
              </div>
              <h1>{view === 'planner' ? 'Make room for you.' : 'See how far you’ve come.'}</h1>
              <p>
                {view === 'planner'
                  ? 'Explore your interests. Try something new. Grow at your own pace.'
                  : 'Your saved plans, ready whenever you want to return.'}
              </p>
            </div>
            <span className="heading-decoration" aria-hidden="true">
              <Sprout size={54} strokeWidth={1.1} />
            </span>
          </section>
          {error && (
            <div className="alert error" role="alert">
              <HelpCircle size={18} />
              <span>{error}</span>
              {user && (
                <button onClick={reload} disabled={busy}>
                  Reload saved week
                </button>
              )}
              <button aria-label="Dismiss error" onClick={() => setError('')}>
                <X size={16} />
              </button>
            </div>
          )}
          {notice && (
            <div className="alert success" role="status">
              <Check size={18} />
              <span>{notice}</span>
              <button aria-label="Dismiss message" onClick={() => setNotice('')}>
                <X size={16} />
              </button>
            </div>
          )}
          {view === 'weeks' ? (
            <section className="weeks-section">
              {weeks.length ? (
                weeks.map((plan) => (
                  <button
                    className="week-card"
                    key={plan.id}
                    onClick={() => {
                      navigateWeek(plan.preferences.weekStart)
                      setView('planner')
                    }}
                  >
                    <span className="week-card-icon">
                      <CalendarDays size={24} />
                    </span>
                    <span>
                      <strong>
                        Week of{' '}
                        {DateTime.fromISO(plan.preferences.weekStart).toFormat('MMMM d, yyyy')}
                      </strong>
                      <small>
                        {plan.preferences.primary} · {plan.activityCount} activities ·{' '}
                        {Number((plan.totalMinutes / 60).toFixed(2))} hours
                      </small>
                    </span>
                    <ArrowRight size={20} />
                  </button>
                ))
              ) : (
                <div className="empty-state">
                  <CalendarDays size={34} />
                  <h2>Your story starts this week.</h2>
                  <p>Generate and save your first plan to see it here.</p>
                  <button className="button primary" onClick={() => setView('planner')}>
                    Plan my week <ArrowRight size={17} />
                  </button>
                </div>
              )}
              {nextCursor && (
                <button
                  className="button"
                  disabled={busy}
                  onClick={() => void showWeeks(nextCursor)}
                >
                  Load older weeks <ArrowDown size={16} />
                </button>
              )}
            </section>
          ) : (
            <>
              <div className="week-navigation">
                <div className="week-title">
                  <span className="calendar-icon">
                    <CalendarDays size={20} />
                  </span>
                  <div>
                    <h2>{weekLabel}</h2>
                    <p>
                      Week {weekDate.weekNumber} <span>·</span>{' '}
                      {user
                        ? dirty
                          ? 'Unsaved draft'
                          : saved
                            ? 'Saved plan'
                            : 'Your next chapter'
                        : dirty
                          ? 'Preview draft · sign in to save'
                          : 'Sample week · sign in to save'}
                    </p>
                  </div>
                </div>
                <div className="week-controls">
                  <button
                    className="button today-button"
                    disabled={busy}
                    onClick={() => navigateWeek(DateTime.local().startOf('week').toISODate()!)}
                  >
                    This week
                  </button>
                  <div className="arrow-group">
                    <button
                      aria-label="Previous week"
                      disabled={busy}
                      onClick={() => navigateWeek(weekDate.minus({ weeks: 1 }).toISODate()!)}
                    >
                      <ChevronLeft size={18} />
                    </button>
                    <button
                      aria-label="Next week"
                      disabled={busy}
                      onClick={() => navigateWeek(weekDate.plus({ weeks: 1 }).toISODate()!)}
                    >
                      <ChevronRight size={18} />
                    </button>
                  </div>
                </div>
              </div>
              <section className="stats-row" aria-label="Week summary">
                <div className="stat">
                  <span className="stat-icon blue">
                    <Clock3 size={19} />
                  </span>
                  <div>
                    <span className="stat-number">
                      {Number((totalMinutes / 60).toFixed(2))}
                      <small> hrs</small>
                    </span>
                    <p>
                      Room for growth <span>of {draft.preferences.hours} hrs</span>
                    </p>
                  </div>
                </div>
                <div className="stat">
                  <span className="stat-icon peach">
                    <BookOpen size={19} />
                  </span>
                  <div>
                    <span className="stat-number">
                      {draft.activities.length}
                      <small> activities</small>
                    </span>
                    <p>
                      A week with intention <span>{learningCount} to learn</span>
                    </p>
                  </div>
                </div>
                <div className="stat">
                  <span className="stat-icon sage">
                    <Compass size={19} />
                  </span>
                  <div>
                    <span className="stat-number">
                      {new Set(draft.activities.map((a) => a.topic)).size}
                      <small> interests</small>
                    </span>
                    <p>
                      Follow your curiosity <span>one idea at a time</span>
                    </p>
                  </div>
                </div>
              </section>
              <div className="planner-layout">
                <section className="builder panel">
                  <div className="panel-heading">
                    <div className="title-icon">
                      <Settings2 size={19} />
                      <h2>Shape your week</h2>
                    </div>
                    <span className="step-label">01</span>
                  </div>
                  <p className="section-intro">A few choices. A week that feels like you.</p>
                  <form
                    onSubmit={(e) => {
                      e.preventDefault()
                      void generate()
                    }}
                  >
                    <fieldset disabled={busy || sessionLoading}>
                      <label className="field-label">
                        What are you curious about?
                        <span className="label-hint">Your main interest</span>
                        <select
                          value={preferences.primary}
                          onChange={(e) => {
                            const primary = e.target.value as Preferences['primary']
                            setPreferences((p) => ({
                              ...p,
                              primary,
                              secondary: p.secondary === primary ? null : p.secondary,
                            }))
                          }}
                        >
                          {topics.map((t) => (
                            <option key={t}>{t}</option>
                          ))}
                        </select>
                      </label>
                      <label className="field-label secondary-field">
                        Something else to explore<span className="optional-tag">OPTIONAL</span>
                        <select
                          value={preferences.secondary ?? ''}
                          onChange={(e) =>
                            updatePreference(
                              'secondary',
                              (e.target.value as Preferences['secondary']) || null,
                            )
                          }
                        >
                          <option value="">Just my main interest</option>
                          {topics
                            .filter((t) => t !== preferences.primary)
                            .map((t) => (
                              <option key={t}>{t}</option>
                            ))}
                        </select>
                      </label>
                      <div className="builder-divider" />
                      <div className="field-label">
                        When can you make time?
                        <span className="label-hint">Choose your available days</span>
                      </div>
                      <div className="day-picker">
                        {dayNames.map((day, i) => (
                          <button
                            type="button"
                            key={day}
                            className={preferences.weekdays.includes(i + 1) ? 'chosen' : ''}
                            aria-pressed={preferences.weekdays.includes(i + 1)}
                            aria-label={
                              [
                                'Monday',
                                'Tuesday',
                                'Wednesday',
                                'Thursday',
                                'Friday',
                                'Saturday',
                                'Sunday',
                              ][i]
                            }
                            onClick={() =>
                              updatePreference(
                                'weekdays',
                                preferences.weekdays.includes(i + 1)
                                  ? preferences.weekdays.filter((d) => d !== i + 1)
                                  : [...preferences.weekdays, i + 1],
                              )
                            }
                          >
                            {day.charAt(0)}
                            <span>{day.slice(1)}</span>
                          </button>
                        ))}
                      </div>
                      <div className="form-grid">
                        <label>
                          Hours this week
                          <input
                            type="number"
                            aria-label="Hours this week"
                            value={preferences.hours}
                            min={0.25}
                            max={40}
                            step={0.25}
                            onChange={(e) => updatePreference('hours', Number(e.target.value))}
                          />
                        </label>
                        <label>
                          Time per activity
                          <select
                            value={preferences.duration}
                            onChange={(e) =>
                              updatePreference(
                                'duration',
                                Number(e.target.value) as Preferences['duration'],
                              )
                            }
                          >
                            {[15, 30, 45, 60].map((d) => (
                              <option value={d} key={d}>
                                {d} minutes
                              </option>
                            ))}
                          </select>
                        </label>
                      </div>
                      <label className="start-time">
                        Preferred start time
                        <input
                          type="time"
                          value={preferences.startTime}
                          onChange={(e) => updatePreference('startTime', e.target.value)}
                          required
                        />
                      </label>
                      <label className="timezone-field">
                        Timezone
                        <select
                          value={preferences.timezone}
                          onChange={(e) => updatePreference('timezone', e.target.value)}
                        >
                          {[
                            ...new Set([
                              preferences.timezone,
                              Intl.DateTimeFormat().resolvedOptions().timeZone,
                              'UTC',
                              'Asia/Dhaka',
                              'America/New_York',
                              'Europe/London',
                              'Asia/Singapore',
                            ]),
                          ].map((t) => (
                            <option key={t} value={t}>
                              {t.replaceAll('_', ' ')}
                            </option>
                          ))}
                        </select>
                      </label>
                      <div className="builder-divider" />
                      <div className="field-label goals-label">
                        Make it a little more meaningful
                      </div>
                      <label className="goal-choice">
                        <span className="goal-icon">
                          <Compass size={18} />
                        </span>
                        <span>
                          <strong>Try somewhere new</strong>
                          <small>One 90-minute experience</small>
                        </span>
                        <input
                          type="checkbox"
                          checked={preferences.experience}
                          onChange={(e) => updatePreference('experience', e.target.checked)}
                        />
                      </label>
                      <label className="goal-choice">
                        <span className="goal-icon">
                          <BookOpen size={18} />
                        </span>
                        <span>
                          <strong>Pause and reflect</strong>
                          <small>15 minutes to look back</small>
                        </span>
                        <input
                          type="checkbox"
                          checked={preferences.reflection}
                          onChange={(e) => updatePreference('reflection', e.target.checked)}
                        />
                      </label>
                      <button className="button primary full generate-button" type="submit">
                        {busy ? <Loader2 size={17} className="spin" /> : <Sparkles size={17} />}{' '}
                        Generate my week <ArrowRight size={16} />
                      </button>
                      <p className="builder-footnote">
                        Thoughtfully planned. Always yours to edit.
                      </p>
                    </fieldset>
                  </form>
                </section>
                <section className="calendar-panel panel">
                  <div className="panel-heading">
                    <div className="title-icon">
                      <CalendarDays size={19} />
                      <h2>Your week, at a glance</h2>
                    </div>
                    <div className="view-toggle" aria-label="Calendar view">
                      <button
                        className={calendarMode === 'week' && !compact ? 'selected' : ''}
                        onClick={() => setCalendarMode('week')}
                        disabled={compact}
                      >
                        Week
                      </button>
                      <button
                        className={calendarMode === 'agenda' || compact ? 'selected' : ''}
                        onClick={() => setCalendarMode('agenda')}
                      >
                        Agenda
                      </button>
                    </div>
                  </div>
                  <div className="calendar-subheading">
                    <span>Little moments. Meaningful progress.</span>
                    <span className="draft-badge">
                      <span />
                      {dirty ? 'Draft' : saved ? 'Saved' : 'Preview'}
                    </span>
                  </div>
                  {draft.messages.length > 0 && (
                    <div className="schedule-messages" role="status">
                      {draft.messages.map((m, i) => (
                        <p key={i}>{m}</p>
                      ))}
                    </div>
                  )}
                  {totalMinutes > draft.preferences.hours * 60 && (
                    <p className="schedule-warning">Your edits exceed the weekly time budget.</p>
                  )}
                  {unavailable && (
                    <p className="schedule-warning">
                      Some activities are scheduled outside your selected available days.
                    </p>
                  )}
                  <div className={`calendar-wrap ${busy ? 'loading' : ''}`}>
                    <Suspense
                      fallback={
                        <div className="calendar-empty">
                          <Loader2 size={24} className="spin" />
                          <span>Opening your week…</span>
                        </div>
                      }
                    >
                      <PlannerCalendar
                        key={`${preferences.weekStart}:${compact}`}
                        ref={calendarRef}

                        initialView={
                          compact || calendarMode === 'agenda' ? 'listWeek' : 'timeGridWeek'
                        }
                        initialDate={preferences.weekStart}
                        firstDay={1}
                        headerToolbar={false}
                        events={calendarEvents}
                        editable={!busy}
                        eventResizableFromStart={false}
                        allDaySlot={false}
                        height="auto"
                        slotMinTime={`${Math.min(firstHour, lastHour - 4)
                          .toString()
                          .padStart(2, '0')}:00:00`}
                        slotMaxTime={`${lastHour.toString().padStart(2, '0')}:00:00`}
                        slotDuration="00:30:00"
                        slotLabelFormat={{ hour: 'numeric', minute: '2-digit', hour12: true }}
                        dayHeaderFormat={{ weekday: 'short', day: 'numeric' }}
                        eventTimeFormat={{ hour: 'numeric', minute: '2-digit', hour12: true }}
                        nowIndicator
                        dayMaxEvents={false}
                        displayEventEnd={false}
                        slotEventOverlap={false}
                        eventMinHeight={64}
                        eventInteractive
                        eventDidMount={(info) =>
                          info.el.setAttribute(
                            'aria-label',
                            `${info.event.title}, ${info.event.extendedProps.activity.topic}, ${info.event.extendedProps.activity.duration} minutes`,
                          )
                        }
                        noEventsContent={() => (
                          <div className="calendar-empty">
                            <Sprout size={32} />
                            <strong>A fresh week awaits.</strong>
                            <span>Choose your interests and generate your plan.</span>
                          </div>
                        )}
                        eventClick={(info) => {
                          if (!busy) setSelected(info.event.extendedProps.activity)
                        }}
                        eventDrop={(info) => {
                          const activity = info.event.extendedProps.activity as Activity
                          const start = info.event.startStr.slice(0, 16)
                          const changed = { ...activity, start }
                          const issues = validateActivities(
                            draft.preferences,
                            draft.activities.map((a) => (a.id === changed.id ? changed : a)),
                          )
                          if (issues.length) {
                            info.revert()
                            setError(issues.join(' '))
                          } else apply(changed)
                        }}
                        eventResize={(info) => {
                          const activity = info.event.extendedProps.activity as Activity
                          const duration = Math.round(
                            DateTime.fromISO(info.event.endStr.slice(0, 16), {
                              zone: draft.preferences.timezone,
                            }).diff(
                              DateTime.fromISO(info.event.startStr.slice(0, 16), {
                                zone: draft.preferences.timezone,
                              }),
                              'minutes',
                            ).minutes,
                          )
                          const changed = { ...activity, duration }
                          const parsed = activitySchema.safeParse(changed)
                          const issues = validateActivities(
                            draft.preferences,
                            draft.activities.map((a) => (a.id === changed.id ? changed : a)),
                          )
                          if (!parsed.success || issues.length) {
                            info.revert()
                            setError(
                              issues.join(' ') ||
                                'Use a duration between 15 and 240 minutes, in 15-minute steps.',
                            )
                          } else apply(changed)
                        }}
                        snapDuration="00:15:00"
                        eventContent={(info) => {
                          const activity = info.event.extendedProps.activity as Activity
                          return (
                            <div className="activity-event">
                              <span className="event-category">
                                {activity.kind === 'experience' ? (
                                  <Compass size={12} />
                                ) : activity.kind === 'reflect' ? (
                                  <BookOpen size={12} />
                                ) : (
                                  <span className="dot" />
                                )}
                                {activity.topic}
                              </span>
                              <strong>{activity.title}</strong>
                              <span className="event-duration">
                                {activity.duration} min <span>· {info.timeText}</span>
                              </span>
                            </div>
                          )
                        }}
                      />
                    </Suspense>
                  </div>
                  <div className="calendar-footer">
                    <span>
                      <span className="legend-dot" />
                      Click an activity to make it yours
                    </span>
                    <span className="desktop-hint">Drag to reschedule</span>
                  </div>
                </section>
              </div>
              <section className="save-bar">
                <div>
                  <span className="save-icon">
                    <Sprout size={21} />
                  </span>
                  <span>
                    <strong>A week worth looking forward to.</strong>
                    <small>
                      {user
                        ? dirty
                          ? 'Happy with your plan? Save it to your personal space.'
                          : saved
                            ? 'Your plan is saved and ready when you are.'
                            : 'Generate a plan, then make it yours.'
                        : 'Create an account to keep your plan across devices.'}
                    </small>
                  </span>
                </div>
                <button
                  className="button primary"
                  onClick={save}
                  disabled={busy || sessionLoading || (!!user && !dirty)}
                >
                  {busy ? <Loader2 size={17} className="spin" /> : <Save size={17} />}{' '}
                  {user && saved && !dirty ? 'Week saved' : 'Save my week'}
                </button>
              </section>
              <p className="bottom-note">
                <Sprout size={13} /> Growth isn’t a race. You’re right where you need to be.
              </p>
            </>
          )}
        </main>
      </div>
      {auth && (
        <AuthDialog
          initial={auth}
          token={token}
          onClose={() => {
            setAuth(null)
            if (token) history.replaceState(null, '', '/')
          }}
          onLogin={(account) => {
            setUser(account)
            setPreferences((p) => ({ ...p, timezone: account.timezone }))
            setNotice('Welcome back. Your saved weeks are ready.')
          }}
        />
      )}
      {selected && (
        <ActivityDialog
          activity={selected}
          preferences={draft.preferences}
          activities={draft.activities}
          onClose={() => setSelected(null)}
          onApply={apply}
          onDelete={() => {
            setDraft((d) => ({
              ...d,
              activities: d.activities.filter((a) => a.id !== selected.id),
            }))
            setDirty(true)
          }}
        />
      )}
    </div>
  )
}
