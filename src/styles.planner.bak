@import 'tailwindcss';
:root {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: #242730;
  background: #f7f8fa;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  font-size: 14px;
  --blue: #2463eb;
  --muted: #848992;
  --line: #eceef2;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
}
button,
input,
select,
textarea {
  font: inherit;
}
button,
a,
input,
select,
textarea {
  -webkit-tap-highlight-color: transparent;
}
button {
  cursor: pointer;
}
button:disabled {
  cursor: default;
  opacity: 0.5;
}
button,
a {
  transition:
    background 0.16s ease,
    color 0.16s ease,
    box-shadow 0.16s ease;
}
button {
  border: 0;
  background: none;
  color: inherit;
}
a {
  color: inherit;
  text-decoration: none;
}
button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 3px solid #2463eb55;
  outline-offset: 3px;
}
svg {
  flex-shrink: 0;
}
fieldset {
  border: 0;
  margin: 0;
  padding: 0;
  min-width: 0;
}
h1,
h2,
h3,
p {
  margin: 0;
}
.app-shell {
  display: flex;
  min-height: 100vh;
}
.sidebar {
  width: 224px;
  flex-shrink: 0;
  background: #fff;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  padding: 36px 20px 20px;
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 20;
}
.brand {
  display: flex;
  align-items: center;
  font-size: 28px;
  font-weight: 680;
  letter-spacing: -1.5px;
  padding-left: 7px;
}
.brand-mark {
  background: var(--blue);
  width: 35px;
  height: 35px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  color: #fff;
  margin-right: 10px;
}
.brand-period {
  color: var(--blue);
}
.workspace-label {
  font-size: 9px;
  letter-spacing: 1.3px;
  color: #6f7988;
  margin: 48px 12px 17px;
  font-weight: 600;
}
.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 13px;
  min-height: 46px;
  border-radius: 8px;
  color: #6f7988;
  font-size: 13px;
  margin-bottom: 7px;
  text-align: left;
}
.nav-item.active {
  background: #edf3ff;
  color: var(--blue);
  font-weight: 600;
}
.nav-item:hover {
  background: #f3f6fc;
}
.nav-dot {
  width: 5px;
  height: 5px;
  background: var(--blue);
  border-radius: 100%;
  margin-left: auto;
}
.sidebar-note {
  margin: 55px 9px 20px;
  padding: 20px 0;
}
.note-icon {
  color: #749086;
}
.sidebar-note h3 {
  font-size: 20px;
  line-height: 1.55;
  letter-spacing: -0.4px;
  font-weight: 500;
  margin: 15px 0 10px;
}
.sidebar-note p {
  font-size: 12px;
  color: #6f7988;
  line-height: 1.8;
}
.note-line {
  display: block;
  width: 28px;
  height: 2px;
  background: #dde7df;
  margin-top: 24px;
}
.sidebar-bottom {
  margin-top: auto;
}
.private-label {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #6f7988;
  font-size: 10px;
  margin: 0 8px 20px;
}
.profile {
  display: flex;
  align-items: center;
  gap: 10px;
  border-top: 1px solid var(--line);
  padding: 20px 2px 0;
  width: 100%;
  text-align: left;
}
.avatar,
.top-avatar {
  height: 34px;
  width: 34px;
  border-radius: 50%;
  background: #f0f3f7;
  color: #758395;
  display: grid;
  place-items: center;
  font-size: 13px;
  font-weight: 600;
}
.profile > span:nth-child(2) {
  flex: 1;
  min-width: 0;
}
.profile strong {
  display: block;
  font-size: 11px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile small {
  font-size: 9px;
  color: #6f7988;
  display: block;
  margin-top: 4px;
}
.profile > svg {
  color: #989fab;
}
.main-shell {
  margin-left: 224px;
  width: calc(100% - 224px);
}
.topbar {
  height: 76px;
  border-bottom: 1px solid var(--line);
  background: #ffffffb0;
  padding: 0 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.desktop-breadcrumb {
  display: flex;
  align-items: center;
  gap: 13px;
  font-size: 11px;
  color: #6f7988;
}
.desktop-breadcrumb strong {
  font-weight: 500;
  color: #555e6a;
}
.topbar-actions {
  display: flex;
  align-items: center;
  gap: 20px;
}
.today {
  font-size: 11px;
  color: #6f7988;
}
.mobile-brand,
.mobile-menu-button {
  display: none !important;
}
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid #e4e7ec;
  border-radius: 8px;
  padding: 11px 16px;
  min-height: 42px;
  background: #fff;
  font-size: 12px;
  font-weight: 550;
  white-space: nowrap;
}
.button:hover {
  background: #f6f8fb;
}
.button.primary {
  background: var(--blue);
  color: white;
  border-color: var(--blue);
  box-shadow: 0 3px 7px #2463eb12;
}
.button.primary:hover {
  background: #1853d5;
}
.button.compact {
  padding: 7px 12px;
  min-height: 34px;
  font-size: 11px;
}
.button.full {
  width: 100%;
}
.button.danger {
  color: #b54545;
  background: white;
  border-color: #eedfdf;
}
.icon-button {
  display: grid;
  place-items: center;
  min-width: 40px;
  min-height: 40px;
  border-radius: 8px;
  color: #6f7988;
}
.icon-button:hover {
  background: #f1f3f6;
}
main {
  padding: 40px 44px 25px;
  max-width: 1600px;
  margin: 0 auto;
}
.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 35px;
}
.eyebrow {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 9px;
  letter-spacing: 1.65px;
  font-weight: 650;
  color: #6f7988;
  margin-bottom: 13px;
}
.tiny-spark {
  color: #6e88b9;
  display: flex;
}
h1 {
  font-size: 35px;
  line-height: 1.2;
  letter-spacing: -1.3px;
  font-weight: 600;
}
.page-heading p {
  font-size: 12px;
  line-height: 1.7;
  color: #6f7988;
  margin-top: 12px;
}
.heading-decoration {
  color: #c0cdc5;
  margin-right: 14px;
  transform: rotate(9deg);
}
.week-navigation {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22px;
}
.week-title {
  display: flex;
  align-items: center;
  gap: 12px;
}
.calendar-icon {
  width: 42px;
  height: 42px;
  border: 1px solid #e8ebf1;
  border-radius: 11px;
  display: grid;
  place-items: center;
  background: #fff;
  color: #7e8da5;
}
.week-title h2 {
  font-weight: 600;
  font-size: 15px;
  letter-spacing: -0.2px;
}
.week-title p {
  font-size: 10px;
  color: #6f7988;
  margin-top: 6px;
}
.week-title p span {
  margin: 0 6px;
}
.week-controls {
  display: flex;
  align-items: center;
  gap: 10px;
}
.today-button {
  font-size: 10px;
  padding: 8px 12px;
  min-height: 34px;
}
.arrow-group {
  border: 1px solid #e4e7ec;
  border-radius: 8px;
  display: flex;
  background: #fff;
  overflow: hidden;
}
.arrow-group button {
  width: 36px;
  height: 34px;
  display: grid;
  place-items: center;
  color: #777f8b;
}
.arrow-group button + button {
  border-left: 1px solid var(--line);
}
.arrow-group button:hover {
  background: #f0f4fa;
}
.stats-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid #e8ebf0;
  border-radius: 12px;
  background: #fff;
  margin-bottom: 27px;
  padding: 21px 0;
}
.stat {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 0 25px;
  border-right: 1px solid var(--line);
}
.stat:last-child {
  border-right: 0;
}
.stat-icon {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
}
.blue {
  color: #688cda;
  background: #f0f5ff;
}
.peach {
  color: #b58b64;
  background: #fbf4ed;
}
.sage {
  color: #7b9986;
  background: #f0f6f1;
}
.stat-number {
  font-size: 23px;
  font-weight: 600;
  letter-spacing: -0.65px;
}
.stat-number small {
  font-size: 11px;
  letter-spacing: 0;
  color: #6f7988;
  font-weight: 400;
  margin-left: 2px;
}
.stat p {
  font-size: 10px;
  margin-top: 5px;
  color: #6f7988;
}
.stat p span {
  font-size: 9px;
  color: #6f7988;
  margin-left: 7px;
}
.planner-layout {
  display: grid;
  grid-template-columns: 300px minmax(0, 1fr);
  gap: 23px;
  align-items: start;
}
.panel {
  background: #fff;
  border: 1px solid #e8ebf0;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 4px #161e3402;
}
.builder {
  padding: 22px;
}
.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.title-icon {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #7c889a;
}
.title-icon h2 {
  font-size: 13px;
  color: #343b47;
  font-weight: 600;
}
.step-label {
  font-size: 10px;
  color: #c1c6ce;
  letter-spacing: 1px;
}
.section-intro {
  font-size: 10px;
  color: #6f7988;
  margin: 9px 0 26px;
  line-height: 1.7;
}
.field-label {
  display: block;
  position: relative;
  font-size: 11px;
  font-weight: 550;
  color: #5b6370;
}
.label-hint {
  display: block;
  font-size: 10px;
  font-weight: 400;
  color: #6f7988;
  margin: 6px 0 10px;
}
.field-label select {
  margin-top: 10px;
}
.field-label .label-hint + select {
  margin-top: 0;
}
input:not([type='checkbox']),
select,
textarea {
  width: 100%;
  border: 1px solid #e3e7ee;
  border-radius: 7px;
  padding: 11px 10px;
  min-height: 41px;
  background: #fbfcfe;
  color: #49515f;
  font-size: 11px;
  transition: border-color 0.15s;
  min-width: 0;
}
input:hover,
select:hover,
textarea:hover {
  border-color: #b9c9e6;
}
input:focus,
select:focus,
textarea:focus {
  border-color: #7ca1ed;
}
select {
  appearance: auto;
  cursor: pointer;
}
textarea {
  resize: vertical;
  line-height: 1.7;
}
.secondary-field {
  margin-top: 19px;
}
.optional-tag {
  font-size: 7px;
  letter-spacing: 0.7px;
  background: #f3f5f8;
  color: #6f7988;
  padding: 3px 4px;
  border-radius: 3px;
  margin-left: 8px;
  font-weight: 500;
}
.builder-divider {
  height: 1px;
  background: var(--line);
  margin: 24px 0 22px;
}
.day-picker {
  display: flex;
  gap: 5px;
  margin: 12px 0 19px;
}
.day-picker button {
  border-radius: 7px;
  min-height: 39px;
  flex: 1;
  border: 1px solid #e9edf3;
  color: #9ca4b1;
  background: #fff;
  font-size: 10px;
  min-width: 0;
}
.day-picker button.chosen {
  color: #487bdc;
  background: #eff5ff;
  border-color: #d5e3ff;
}
.day-picker button:hover {
  border-color: #90b1ed;
}
.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
label {
  display: block;
  font-size: 11px;
  font-weight: 500;
  color: #626c7a;
}
.form-grid label input,
.form-grid label select {
  margin-top: 9px;
}
.start-time {
  display: grid;
  grid-template-columns: 1fr 104px;
  align-items: center;
  margin-top: 16px;
  font-size: 10px;
  color: #6f7988;
}
.start-time input {
  padding: 7px;
  min-height: 36px;
}
.timezone-field {
  margin-top: 16px;
  font-size: 10px;
  color: #6f7988;
}
.timezone-field select {
  margin-top: 8px;
  min-height: 35px;
  padding: 7px;
}
.goals-label {
  margin-bottom: 16px;
  font-size: 10px;
}
.goal-choice {
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 11px 0;
  cursor: pointer;
}
.goal-icon {
  width: 30px;
  height: 30px;
  border-radius: 7px;
  display: grid;
  place-items: center;
  background: #f5f7fa;
  color: #8f9cad;
}
.goal-choice > span:nth-child(2) {
  flex: 1;
}
.goal-choice strong {
  font-size: 10px;
  color: #586373;
  font-weight: 500;
  display: block;
}
.goal-choice small {
  display: block;
  color: #6f7988;
  font-size: 9px;
  margin-top: 4px;
}
.goal-choice input {
  accent-color: var(--blue);
  width: 16px;
  height: 16px;
  cursor: pointer;
}
.generate-button {
  margin-top: 22px;
  height: 43px;
  font-size: 11px;
}
.generate-button svg:last-child {
  margin-left: auto;
}
.generate-button svg:first-child {
  margin-right: auto;
}
.builder-footnote {
  font-size: 8px;
  color: #6f7988;
  text-align: center;
  margin-top: 12px;
}
.calendar-panel .panel-heading {
  padding: 22px 22px 0;
}
.view-toggle {
  display: flex;
  padding: 3px;
  background: #f5f6f9;
  border-radius: 6px;
  gap: 2px;
}
.view-toggle button {
  font-size: 9px;
  padding: 6px 9px;
  min-height: 28px;
  color: #6f7988;
  border-radius: 4px;
}
.view-toggle button.selected {
  background: #fff;
  color: #505b6b;
  box-shadow: 0 1px 3px #1e2b4312;
}
.calendar-subheading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 22px 22px;
  font-size: 10px;
  color: #6f7988;
  gap: 10px;
}
.draft-badge {
  display: flex;
  align-items: center;
  gap: 5px;
  background: #f7f8fb;
  border: 1px solid #edf0f4;
  border-radius: 5px;
  padding: 3px 7px;
  font-size: 8px;
  white-space: nowrap;
}
.draft-badge > span {
  width: 4px;
  height: 4px;
  background: #8e9bad;
  border-radius: 50%;
}
.calendar-wrap {
  padding: 0 12px 0 4px;
  transition: opacity 0.15s;
  min-height: 380px;
}
.calendar-wrap.loading {
  opacity: 0.4;
  pointer-events: none;
}
.fc {
  --fc-border-color: #f0f2f6;
  --fc-today-bg-color: #f8faff;
  --fc-page-bg-color: #fff;
  --fc-list-event-hover-bg-color: #f7faff;
  font-size: 10px;
}
.fc .fc-scrollgrid {
  border: 0;
}
.fc th {
  font-weight: 500;
}
.fc .fc-col-header-cell {
  padding: 12px 0 14px;
  color: #6f7988;
  border-top: 1px solid #f0f2f6;
  border-right: 0;
}
.fc .fc-col-header-cell.fc-day-today {
  color: var(--blue);
}
.fc .fc-timegrid-slot {
  height: 38px;
}
.fc .fc-timegrid-axis-cushion,
.fc .fc-timegrid-slot-label-cushion {
  color: #6f7988;
  font-size: 8px;
  font-weight: 400;
}
.fc .fc-timegrid-slot-minor {
  border-top-style: solid;
}
.fc .fc-timegrid-slot-lane {
  border-top: 1px solid #f4f5f8;
}
.fc .fc-timegrid-now-indicator-line {
  border-color: #e0a9aa;
  opacity: 0.7;
}
.fc .fc-timegrid-now-indicator-arrow {
  border-color: #e0a9aa;
}
.fc .fc-timegrid-event {
  border-width: 0 0 0 2px;
  border-radius: 5px;
  box-shadow: none;
  padding: 4px;
  cursor: pointer;
  margin: 1px 1px;
}
.fc .fc-timegrid-event .fc-event-main {
  color: inherit;
  overflow: hidden;
}
.fc .fc-timegrid-event:hover {
  filter: brightness(0.97);
}
.activity-event {
  display: flex;
  flex-direction: column;
  gap: 4px;
  overflow: hidden;
  height: 100%;
}
.event-category {
  display: flex;
  align-items: center;
  gap: 3px;
  font-size: 7px;
  font-weight: 500;
  opacity: 0.8;
  white-space: nowrap;
  overflow: hidden;
}
.dot {
  display: inline-block;
  width: 4px;
  height: 4px;
  background: currentColor;
  border-radius: 50%;
  flex-shrink: 0;
}
.activity-event strong {
  font-size: 9px;
  font-weight: 550;
  line-height: 1.5;
  overflow: hidden;
}
.event-duration {
  font-size: 7px;
  opacity: 0.7;
  white-space: nowrap;
  margin-top: auto;
}
.event-duration span {
  display: none;
}
.fc .fc-list {
  border: 0;
}
.fc .fc-list-day-cushion {
  background: #f8f9fb;
  padding: 13px 16px;
  color: #7f8a99;
  font-size: 10px;
}
.fc .fc-list-event-time {
  font-size: 10px;
  color: #8f99a7;
  padding-top: 16px;
}
.fc .fc-list-event-graphic {
  padding-top: 19px;
}
.fc .fc-list-event-dot {
  border-width: 4px !important;
}
.fc .fc-list-event-title {
  padding: 13px 10px;
  cursor: pointer;
}
.fc .fc-list-event-title .activity-event {
  gap: 5px;
}
.fc .fc-list-event-title .activity-event strong {
  font-size: 12px;
}
.fc .fc-list-event-title .event-category,
.fc .fc-list-event-title .event-duration {
  font-size: 9px;
}
.fc .fc-list-event-title .event-duration {
  margin-top: 0;
}
.fc .fc-list-event-title .event-duration span {
  display: inline;
}
.fc .fc-list-empty {
  background: #fff;
  min-height: 400px;
}
.calendar-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  color: #8999ad;
  padding: 70px 16px;
}
.calendar-empty strong {
  font-size: 17px;
  font-weight: 500;
  color: #556175;
}
.calendar-empty span {
  font-size: 11px;
  color: #9ca5b2;
}
.calendar-footer {
  border-top: 1px solid var(--line);
  padding: 16px 22px;
  display: flex;
  justify-content: space-between;
  gap: 10px;
  font-size: 9px;
  color: #6f7988;
}
.calendar-footer > span:first-child {
  display: flex;
  align-items: center;
  gap: 6px;
}
.legend-dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #b1bccd;
}
.save-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24px;
  padding: 21px 23px;
  background: #fff;
  border: 1px solid #e8ebf0;
  border-radius: 11px;
  gap: 18px;
}
.save-bar > div {
  display: flex;
  align-items: center;
  gap: 13px;
}
.save-icon {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 10px;
  background: #f3f7f4;
  color: #93a99a;
}
.save-bar strong {
  display: block;
  font-size: 11px;
  font-weight: 550;
  color: #566171;
}
.save-bar small {
  display: block;
  font-size: 10px;
  color: #6f7988;
  margin-top: 6px;
  line-height: 1.6;
}
.save-bar .button {
  font-size: 11px;
  min-width: 139px;
}
.bottom-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  font-size: 9px;
  color: #6f7988;
  margin-top: 25px;
}
.alert {
  padding: 13px 16px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 20px;
  font-size: 12px;
  line-height: 1.6;
}
.alert span {
  flex: 1;
}
.alert button {
  font-size: 11px;
  padding: 5px;
  border-radius: 4px;
}
.alert.error {
  background: #fff0ef;
  color: #a54c48;
  border: 1px solid #f4dad7;
}
.alert.success {
  background: #edf6f0;
  color: #47765a;
  border: 1px solid #d8eade;
}
.schedule-messages,
.schedule-warning {
  padding: 10px 20px;
  background: #fff9ee;
  color: #a1834b;
  border-top: 1px solid #f7e8ce;
  font-size: 10px;
  line-height: 1.6;
}
.schedule-messages p + p {
  margin-top: 6px;
}
.modal {
  border: 1px solid #e4e8ef;
  border-radius: 16px;
  padding: 26px;
  width: 440px;
  max-width: calc(100vw - 28px);
  max-height: calc(100dvh - 40px);
  margin: auto;
  box-shadow: 0 24px 100px #0f21332b;
  color: #303744;
  background: #fff;
  animation: dialog-in 0.18s ease-out;
  overflow-y: auto;
}
.modal::backdrop {
  background: #15223855;
  backdrop-filter: blur(5px);
}
.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 15px;
}
.modal h2 {
  font-size: 23px;
  font-weight: 550;
  letter-spacing: -0.6px;
}
.modal-intro {
  font-size: 12px;
  line-height: 1.7;
  color: #98a0ad;
  margin-bottom: 24px;
}
.auth-form label,
.activity-form > label {
  margin-bottom: 17px;
  font-size: 12px;
}
.auth-form input,
.activity-form input,
.activity-form textarea {
  margin-top: 8px;
  font-size: 13px;
  padding: 12px;
}
.auth-form .button {
  margin-top: 8px;
  font-size: 13px;
  min-height: 46px;
}
.auth-links {
  font-size: 11px;
  display: flex;
  flex-wrap: wrap;
  gap: 15px;
  justify-content: space-between;
  margin-top: 20px;
  color: #8f98a8;
}
.auth-links button {
  color: #3571dc;
  min-height: 28px;
}
.auth-links p {
  width: 100%;
  text-align: center;
}
.privacy-note {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 7px;
  border-top: 1px solid var(--line);
  padding-top: 17px;
  margin-top: 20px;
  font-size: 10px;
  color: #6f7988;
}
.inline-error,
.inline-success {
  font-size: 12px;
  padding: 10px;
  border-radius: 6px;
  line-height: 1.6;
  margin: 10px 0;
}
.inline-error {
  background: #fff0ee;
  color: #b3564c;
}
.inline-success {
  background: #edf7f0;
  color: #53866c;
}
.dev-note {
  font-size: 11px;
  line-height: 1.6;
  padding: 10px;
  background: #f2f5fa;
  margin: 12px 0;
  border-radius: 6px;
  color: #8292a9;
}
.dev-note a {
  color: #2864d5;
  display: flex;
  align-items: center;
  gap: 5px;
  margin-top: 7px;
}
.activity-form .form-grid {
  margin-bottom: 17px;
}
.topic-label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #f6f7f9;
  font-size: 10px;
  padding: 6px 9px;
  border-radius: 5px;
  margin-bottom: 20px;
}
.hint {
  font-size: 10px;
  color: #6f7988;
  line-height: 1.6;
}
.modal-actions {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 22px;
}
.spin {
  animation: spin 1s linear infinite;
}
.weeks-section {
  display: grid;
  gap: 15px;
}
.week-card {
  display: flex;
  align-items: center;
  gap: 18px;
  background: white;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 22px;
  text-align: left;
}
.week-card:hover {
  border-color: #adc5ee;
  background: #fcfdff;
}
.week-card > span:nth-child(2) {
  flex: 1;
}
.week-card strong {
  display: block;
  font-weight: 500;
  font-size: 15px;
}
.week-card small {
  display: block;
  margin-top: 8px;
  font-size: 11px;
  color: #6f7988;
  line-height: 1.6;
}
.week-card > svg {
  color: #8c9bb3;
}
.week-card-icon {
  width: 44px;
  height: 44px;
  background: #eff4fc;
  border-radius: 10px;
  display: grid;
  place-items: center;
  color: #7f9ac5;
}
.empty-state {
  text-align: center;
  padding: 80px 20px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 12px;
}
.empty-state > svg {
  margin: 0 auto;
  color: #9cb0cf;
}
.empty-state h2 {
  font-size: 23px;
  font-weight: 500;
  margin: 20px 0 10px;
}
.empty-state p {
  font-size: 13px;
  color: #6f7988;
  margin-bottom: 25px;
}
.nav-scrim {
  display: none;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
@keyframes dialog-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@media (min-width: 1500px) {
  .planner-layout {
    grid-template-columns: 330px minmax(0, 1fr);
  }
  .builder {
    padding: 27px;
  }
  .fc .fc-timegrid-slot {
    height: 40px;
  }
  .activity-event strong {
    font-size: 11px;
  }
  .event-category,
  .event-duration {
    font-size: 9px;
  }
  .calendar-panel .panel-heading {
    padding: 27px 27px 0;
  }
  .calendar-subheading {
    padding: 12px 27px 25px;
  }
  .stat {
    padding: 0 30px;
  }
}
@media (max-width: 1190px) {
  .sidebar {
    width: 190px;
    padding: 30px 14px 18px;
  }
  .main-shell {
    margin-left: 190px;
    width: calc(100% - 190px);
  }
  main {
    padding: 30px 25px 25px;
  }
  .topbar {
    padding: 0 25px;
  }
  .planner-layout {
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 17px;
  }
  .builder {
    padding: 18px;
  }
  .stat {
    padding: 0 17px;
    gap: 10px;
  }
  .stat p span {
    display: none;
  }
  .stat-number {
    font-size: 21px;
  }
  .calendar-panel .panel-heading {
    padding: 20px 16px 0;
  }
  .title-icon h2 {
    font-size: 12px;
  }
  .calendar-subheading {
    padding: 10px 16px 20px;
  }
  .calendar-wrap {
    padding-right: 4px;
  }
  .view-toggle button {
    padding: 5px 7px;
  }
  .calendar-footer {
    padding: 14px 16px;
  }
  .desktop-hint {
    display: none;
  }
  .day-picker {
    gap: 4px;
  }
  .day-picker button {
    font-size: 9px;
  }
  .brand {
    font-size: 25px;
  }
  .profile strong {
    font-size: 10px;
  }
  .profile small {
    font-size: 8px;
  }
  .optional-tag {
    font-size: 6px;
  }
  .fc .fc-timegrid-slot {
    height: 40px;
  }
}
@media (max-width: 1000px) and (min-width: 768px) {
  .planner-layout {
    grid-template-columns: 1fr;
  }
  .builder form fieldset {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .builder form fieldset .builder-divider {
    display: none;
  }
  .section-intro {
    margin-bottom: 18px;
  }
  .secondary-field {
    margin: 0;
  }
  .day-picker {
    margin: 0;
    align-self: center;
  }
  .builder .form-grid {
    grid-column: 1;
  }
  .start-time {
    margin: 0;
    align-self: end;
  }
  .timezone-field {
    margin: 0;
  }
  .goals-label {
    align-self: center;
    margin: 0;
  }
  .goal-choice {
    margin: 0;
  }
  .generate-button {
    margin: 0;
    align-self: center;
  }
  .builder-footnote {
    margin: 0;
    align-self: center;
  }
  .fc .fc-timegrid-slot {
    height: 40px;
  }
  .activity-event strong {
    font-size: 11px;
  }
  .event-category,
  .event-duration {
    font-size: 9px;
  }
}
@media (max-width: 767px) {
  .sidebar {
    transform: translateX(-100%);
    width: 245px;
    transition: transform 0.2s ease;
    z-index: 40;
  }
  .sidebar.mobile-open {
    transform: translateX(0);
  }
  .nav-scrim {
    display: block;
    position: fixed;
    inset: 0;
    background: #16253855;
    z-index: 30;
  }
  .main-shell {
    margin: 0;
    width: 100%;
  }
  .topbar {
    height: 63px;
    padding: 0 18px;
    position: sticky;
    top: 0;
    z-index: 15;
    background: #ffffffed;
    backdrop-filter: blur(12px);
  }
  .desktop-breadcrumb {
    display: none;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .mobile-brand {
    display: flex !important;
    align-items: center;
    gap: 6px;
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.7px;
  }
  .mobile-brand svg {
    color: var(--blue);
  }
  .mobile-menu-button {
    display: grid !important;
    min-width: 32px;
  }
  .today {
    display: none;
  }
  .topbar-actions {
    gap: 10px;
  }
  .button.compact {
    min-height: 40px;
  }
  main {
    padding: 29px 18px 25px;
  }
  .page-heading {
    margin-bottom: 29px;
  }
  .eyebrow {
    font-size: 8px;
    letter-spacing: 1.1px;
    margin-bottom: 14px;
  }
  h1 {
    font-size: 31px;
    letter-spacing: -1.1px;
  }
  .page-heading p {
    font-size: 12px;
    margin-top: 10px;
    max-width: 280px;
    line-height: 1.8;
  }
  .heading-decoration {
    display: none;
  }
  .week-title h2 {
    font-size: 13px;
  }
  .week-title p {
    font-size: 9px;
    line-height: 1.6;
    max-width: 160px;
  }
  .week-title {
    gap: 8px;
  }
  .calendar-icon {
    width: 35px;
    height: 39px;
  }
  .week-controls {
    gap: 6px;
  }
  .today-button {
    padding: 8px;
    font-size: 9px;
    min-height: 40px;
  }
  .arrow-group button {
    width: 31px;
    height: 40px;
  }
  .week-navigation {
    margin-bottom: 18px;
  }
  .stats-row {
    padding: 17px 0;
    margin-bottom: 20px;
  }
  .stat {
    flex-direction: column;
    align-items: flex-start;
    padding: 0 13px;
    gap: 9px;
  }
  .stat-icon {
    width: 32px;
    height: 32px;
    border-radius: 9px;
  }
  .stat-icon svg {
    width: 16px;
  }
  .stat-number {
    font-size: 22px;
  }
  .stat-number small {
    display: block;
    font-size: 9px;
    margin: 3px 0 0;
  }
  .stat p {
    font-size: 8px;
    line-height: 1.6;
  }
  .stat p span {
    display: none;
  }
  .planner-layout {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .builder,
  .calendar-panel {
    width: 100%;
  }
  .builder {
    padding: 22px;
  }
  .title-icon h2 {
    font-size: 14px;
  }
  .section-intro {
    font-size: 11px;
    margin-bottom: 24px;
  }
  .field-label {
    font-size: 12px;
  }
  .label-hint {
    font-size: 11px;
  }
  .secondary-field {
    margin-top: 20px;
  }
  .optional-tag {
    font-size: 7px;
  }
  .day-picker button {
    font-size: 11px;
    min-height: 44px;
  }
  .day-picker {
    gap: 6px;
  }
  .form-grid {
    gap: 15px;
  }
  label {
    font-size: 12px;
  }
  input:not([type='checkbox']),
  select,
  textarea {
    font-size: 16px;
    min-height: 45px;
    padding: 10px 12px;
  }
  .start-time {
    font-size: 12px;
    grid-template-columns: 1fr 140px;
    margin-top: 19px;
  }
  .start-time input {
    font-size: 16px;
    min-height: 44px;
  }
  .timezone-field {
    font-size: 12px;
  }
  .timezone-field select {
    font-size: 14px;
    min-height: 44px;
  }
  .goal-choice {
    padding: 12px 0;
    gap: 12px;
  }
  .goal-icon {
    width: 35px;
    height: 35px;
  }
  .goal-choice strong {
    font-size: 12px;
  }
  .goal-choice small {
    font-size: 10px;
  }
  .goal-choice input {
    height: 19px;
    width: 19px;
  }
  .goals-label {
    font-size: 12px;
  }
  .generate-button {
    font-size: 13px;
    height: 47px;
  }
  .builder-footnote {
    font-size: 10px;
  }
  .calendar-panel .panel-heading {
    padding: 21px 18px 0;
  }
  .view-toggle button {
    font-size: 10px;
    min-height: 32px;
  }
  .calendar-subheading {
    padding: 12px 18px 20px;
    font-size: 10px;
  }
  .calendar-wrap {
    padding: 0;
    min-height: 200px;
  }
  .calendar-footer {
    padding: 15px 18px;
    font-size: 9px;
  }
  .save-bar {
    flex-direction: column;
    align-items: stretch;
    padding: 20px;
    margin-top: 20px;
    gap: 19px;
  }
  .save-bar strong {
    font-size: 12px;
  }
  .save-bar small {
    font-size: 11px;
  }
  .save-bar .button {
    font-size: 13px;
    min-height: 46px;
  }
  .bottom-note {
    font-size: 9px;
    line-height: 1.8;
    text-align: center;
    gap: 6px;
    margin-top: 22px;
  }
  .alert {
    font-size: 11px;
    padding: 12px;
    flex-wrap: wrap;
  }
  .alert span {
    flex-basis: 75%;
  }
  .alert button {
    min-height: 35px;
  }
  .modal {
    padding: 22px;
    border-radius: 14px;
    max-height: calc(100dvh - 24px);
  }
  .modal h2 {
    font-size: 22px;
  }
  .modal input:not([type='checkbox']),
  .modal select,
  .modal textarea {
    font-size: 16px;
  }
  .modal-actions {
    flex-wrap: wrap;
  }
  .modal-actions .button {
    flex: 1;
    min-height: 44px;
    font-size: 11px;
  }
  .auth-form label,
  .activity-form > label {
    font-size: 13px;
  }
  .week-card {
    padding: 17px;
    gap: 12px;
  }
  .week-card strong {
    font-size: 13px;
  }
  .week-card small {
    font-size: 10px;
  }
  .week-card-icon {
    width: 35px;
    height: 35px;
  }
  .schedule-messages,
  .schedule-warning {
    font-size: 11px;
  }
  .fc .fc-list-event-time {
    font-size: 10px;
    padding: 16px 7px;
  }
  .fc .fc-list-event-graphic {
    padding: 19px 5px;
  }
  .fc .fc-list-event-title {
    padding: 14px 9px;
  }
  .fc .fc-list-event-title .activity-event strong {
    font-size: 12px;
  }
  .fc .fc-list-day-cushion {
    padding: 13px 12px;
  }
  .fc .fc-list-event {
    min-height: 44px;
  }
}
@media (max-width: 360px) {
  main {
    padding-left: 12px;
    padding-right: 12px;
  }
  .stat {
    padding: 0 10px;
  }
  .week-controls {
    gap: 4px;
  }
  .week-title h2 {
    font-size: 12px;
  }
  .calendar-icon {
    display: none;
  }
  .day-picker {
    gap: 4px;
  }
  .calendar-subheading > span:first-child {
    font-size: 9px;
  }
  .title-icon h2 {
    font-size: 12px;
  }
  .calendar-panel .panel-heading {
    padding-left: 14px;
    padding-right: 14px;
  }
  .bottom-note {
    font-size: 8px;
  }
}
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
/* Keep useful labels readable; decoration stays quiet. */
.field-label,
label {
  font-size: 12px;
}
input:not([type='checkbox']),
select,
textarea {
  font-size: 13px;
}
.label-hint,
.section-intro,
.calendar-subheading {
  font-size: 11px;
}
.stat p,
.week-title p,
.calendar-footer {
  font-size: 11px;
}
.stat-number small {
  font-size: 12px;
}
.goal-choice strong {
  font-size: 12px;
}
.goal-choice small {
  font-size: 11px;
}
.builder-footnote {
  font-size: 10px;
}
.fc .fc-timegrid-slot {
  height: 44px;
}
.fc-timegrid .activity-event strong {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  flex-shrink: 0;
  font-size: 10px;
  line-height: 1.25;
}
.fc-timegrid .event-category,
.fc-timegrid .event-duration {
  font-size: 8px;
}
@media (max-width: 767px) {
  input:not([type='checkbox']),
  select,
  textarea {
    font-size: 16px;
  }
  .day-picker {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .day-picker button {
    min-height: 44px;
  }
  .mobile-menu-button {
    min-width: 44px;
  }
  .arrow-group button {
    width: 44px;
    height: 44px;
  }
  .today-button {
    min-height: 44px;
  }
  .view-toggle button {
    min-height: 44px;
    min-width: 44px;
  }
  .view-toggle button:disabled {
    display: none;
  }
  .stat p {
    font-size: 10px;
  }
  .stat-number small {
    font-size: 10px;
  }
  .week-title p {
    font-size: 10px;
  }
  .calendar-footer {
    font-size: 10px;
  }
}
